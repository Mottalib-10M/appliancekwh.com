---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/refrigerator-fit/" title="Which refrigerators fit, and what they cost to run" width="100%" height="1000" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the refrigerator fit tool: certified models and cost" description="Kitchen designers, landlords, utilities and libraries can embed the refrigerator fit tool, with ENERGY STAR models and state electricity prices, in one iframe line." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed the tool', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed the tool' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">Embed the refrigerator fit tool</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code. When the model list and the state prices are reread, the embedded tool follows.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <p>Terms: keep the credit line under the tool visible, do not alter the frame, and do not place it next to a lead form or a store's product feed presented as our selection. The frame sets no cookie and sends us nothing about your readers. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
    <h2>Refrigerator fit and running cost</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/refrigerator-fit/" title="Which refrigerators fit, and what they cost to run" width="100%" height="1000" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
